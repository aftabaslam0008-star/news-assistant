# WorldBrief AI News - Environment Variables
# Copy this file to .env.local to configure your API keys:
# cp .env.example .env.local

# Gemini AI (for the AI Chat Assistant)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# GNews API (for live worldwide news feeds)
# Get a free key at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# YouTube Data API v3 (for live news video streams)
# Get a key at: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here
